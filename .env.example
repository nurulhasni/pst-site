# Copy this file to .env on the server and fill in the values.
# Never commit the real .env.

# --- Admin login ---------------------------------------------------------
# Random string of at least 32 characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every admin out.
SESSION_SECRET=

# One entry per admin, separated by commas. Generate each with:
#   npm run hash-password -- someone@pst.co.id
ADMIN_USERS=

# --- Google Spreadsheet ---------------------------------------------------
# The ID between /d/ and /edit in the Sheet's URL
GOOGLE_SHEET_ID=
# From the service account's JSON key: "client_email" and "private_key".
# Keep the private key on one line with \n where the line breaks are.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Only for older setups where the Sheet is shared publicly. Leave empty.
GOOGLE_API_KEY=

# --- Uploads --------------------------------------------------------------
# Folder for images uploaded from the admin. Defaults to ./uploads.
# Put it somewhere that is backed up, outside the code folder.
UPLOAD_DIR=
