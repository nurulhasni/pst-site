# Copy this file to .env on the server and fill in the values.
# Never commit the real .env.

# --- Admin login ---------------------------------------------------------
# Random string of at least 32 characters, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs every admin out.
SESSION_SECRET=

# One entry per admin, separated by commas. Generate each with:
#   npm run hash-password -- someone@pst.co.id
ADMIN_USERS=

# --- Google Spreadsheet ---------------------------------------------------
# From the service account's JSON key: "client_email" and "private_key".
# Keep the private key on one line with \n where the line breaks are.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# One spreadsheet file per feature: the ID between /d/ and /edit in its URL.
# Share every file with GOOGLE_SERVICE_ACCOUNT_EMAIL as Editor.
# The app creates the tabs (in brackets) and their header row itself.
GOOGLE_SHEET_CLIENTS=          # 1  (Clients, Industries)
GOOGLE_SHEET_SERVICES=         # 2  (Services)
GOOGLE_SHEET_IMPACT_STATS=     # 3  (Impact Stats)
GOOGLE_SHEET_BLOG=             # 4  (Blog, Insights)
GOOGLE_SHEET_CUSTOMER_STORIES= # 5  (Customer Stories)
GOOGLE_SHEET_GALLERY=          # 6  (Gallery)
GOOGLE_SHEET_CAREERS=          # 7  (Careers, Career FAQ)
GOOGLE_SHEET_APPLICATIONS=     # 8  (Applications)
GOOGLE_SHEET_LEADS=            # 9  (Contacts, Downloads, Subscribers)
GOOGLE_SHEET_CHAT_LOG=         # 10 (Chat Log)
GOOGLE_SHEET_ACTIVITY_LOG=     # 11 (Activity Log)
GOOGLE_SHEET_ADMIN_USERS=      # 12 (Admin Users) - share only with IT/owner
# Fallback for any file above that is left empty.
GOOGLE_SHEET_ID=
# Only for older setups where the Sheet is shared publicly. Leave empty.
GOOGLE_API_KEY=

# --- Uploads --------------------------------------------------------------
# Folder for images uploaded from the admin. Defaults to ./uploads.
# Put it somewhere that is backed up, outside the code folder.
UPLOAD_DIR=
